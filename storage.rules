rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (request.auth.token.admin == true
          || request.auth.token.email in ['admin@email.com', 'bestcynix@gmail.com']);
    }

    function isValidImage(maxBytes) {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= maxBytes;
    }

    function isValidDocumentUpload() {
      return request.resource != null
        && request.resource.size <= 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf');
    }

    function isValidChatId(chatId) {
      return chatId.matches('^anon_[A-Za-z0-9]{7}$')
        || (isSignedIn() && chatId == request.auth.uid);
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isAdmin() || (isSignedIn() && request.auth.uid == userId))
        && isValidImage(5 * 1024 * 1024);
    }

    match /chat-attachments/{chatId}/{allPaths=**} {
      allow read: if isAdmin() || isValidChatId(chatId);
      allow write: if (isAdmin() || isValidChatId(chatId)) && isValidImage(5 * 1024 * 1024);
    }

    match /contact-images/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /admin-uploads/{allPaths=**} {
      allow read, write: if isAdmin() && isValidImage(10 * 1024 * 1024);
    }

    // Files are public only because the public docs page embeds them.
    // Only verified admins may upload or delete document assets.
    match /document-assets/mc-skyline/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidDocumentUpload();
      allow delete: if isAdmin();
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/teamGroups/$(groupId)/members/$(request.auth.uid)).data.uid == request.auth.uid;
    }

    match /team-attachments/{groupId}/{allPaths=**} {
      allow read: if isGroupMember(groupId) || isAdmin();
      allow write: if (isGroupMember(groupId) || isAdmin())
        && request.resource != null
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if isGroupMember(groupId) || isAdmin();
    }

    // Sensitive member documents. These paths are never used by public pages.
    match /private-personal/{userId}/identity/{allPaths=**} {
      // Authenticated SDK reads are allowed only for the owner or verified Dev admin.
      // The client uses getBytes() and never creates a shareable Firebase download token.
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if (isAdmin() || (isSignedIn() && request.auth.uid == userId))
        && isValidDocumentUpload();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /private-personal/{userId}/payroll/{allPaths=**} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAdmin() && isValidDocumentUpload();
      allow delete: if isAdmin();
    }

    match /private-personal/{userId}/finance/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidDocumentUpload();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
